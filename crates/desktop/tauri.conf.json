{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Osprey",
  "mainBinaryName": "osprey",
  "identifier": "io.github.indep-arg.osprey",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["default"],
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data: thumb: http://thumb.localhost",
        "style-src": "'self'",
        "font-src": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "rpm"],
    "category": "AudioVideo",
    "shortDescription": "Download videos and music from YouTube and many other sites.",
    "license": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
