#: crates/core/src/app/mod.rs
msgid "The tools can't be changed while a download is running."
msgstr "Las herramientas no se pueden cambiar mientras hay una descarga en curso."

#: crates/core/src/app/mod.rs
#, python-brace-format
msgid "Could not open {url}: {e}"
msgstr "No se pudo abrir {url}: {e}"

#: crates/core/src/app/mod.rs
#, python-brace-format
msgid "Could not find the folder this app is in: {e}"
msgstr "No se encontró la carpeta donde está esta aplicación: {e}"

#: crates/core/src/app/mod.rs
msgid "Where to save downloads"
msgstr "Dónde guardar las descargas"

#: crates/core/src/app/queue.rs
msgid "The output folder doesn't exist yet."
msgstr "La carpeta de destino todavía no existe."

#: crates/core/src/app/queue.rs
msgid "The file isn't there any more."
msgstr "El archivo ya no está."

#: crates/core/src/app/queue.rs
#, python-brace-format
msgid "Could not open it: {e}"
msgstr "No se pudo abrir: {e}"

#: crates/core/src/app/queue.rs
msgid "Stopping the recording..."
msgstr "Deteniendo la grabación..."

#: crates/core/src/app/queue.rs
msgid "Stopping the download..."
msgstr "Deteniendo la descarga..."

#: crates/core/src/app/queue.rs
#, python-brace-format
msgid "Link copied: {url}"
msgstr "Enlace copiado: {url}"

#: crates/core/src/app/queue.rs
msgid "That doesn't look like a link (it should start with http)."
msgstr "Eso no parece un enlace (debería empezar con http)."

#: crates/core/src/app/queue.rs
msgid "Paste a link first."
msgstr "Primero pega un enlace."

#: crates/core/src/app/queue.rs
msgid "That link is already in the queue."
msgstr "Ese enlace ya está en la cola."

#: crates/core/src/app/queue.rs
#, python-brace-format
msgid "{n} of those links is already in the queue."
msgid_plural "{n} of those links are already in the queue."
msgstr[0] "{n} de esos enlaces ya está en la cola."
msgstr[1] "{n} de esos enlaces ya están en la cola."

#: crates/core/src/app/queue.rs
msgid "the lookup was interrupted"
msgstr "la consulta se interrumpió"

#: crates/core/src/app/queue.rs
#, python-brace-format
msgid "Restored {n} link from the last session."
msgid_plural "Restored {n} links from the last session."
msgstr[0] "Se recuperó {n} enlace de la sesión anterior."
msgstr[1] "Se recuperaron {n} enlaces de la sesión anterior."

#: crates/core/src/app/queue.rs
#, python-brace-format
msgid "Could not save the queue: {e}"
msgstr "No se pudo guardar la cola: {e}"

#: crates/core/src/app/queue.rs
msgid "Add at least one link first."
msgstr "Primero agrega al menos un enlace."

#: crates/core/src/app/queue.rs
#, python-brace-format
msgid "Saving into: {folder}"
msgstr "Guardando en: {folder}"

#: crates/core/src/app/queue.rs
#, python-brace-format
msgid "No thumbnail: a .{ext} file can't hold one."
msgstr "Sin miniatura: un archivo .{ext} no puede llevarla."

#: crates/core/src/app/queue.rs
#, python-brace-format
msgid "Saved: {path}"
msgstr "Guardado: {path}"

#: crates/core/src/app/queue.rs
msgid "This is a live stream. Stop ends the recording and saves what it got."
msgstr "Es una transmisión en vivo. Al detenerla, termina la grabación y se guarda lo grabado."

#: crates/core/src/app/queue.rs
msgid "Finished, with nothing new to download"
msgstr "Terminado, no había nada nuevo que descargar"

#: crates/core/src/app/queue.rs
msgid "Download completed"
msgstr "Descarga completada"

#: crates/core/src/app/queue.rs
#, python-brace-format
msgid "Download completed ({n} file)"
msgid_plural "Download completed ({n} files)"
msgstr[0] "Descarga completada ({n} archivo)"
msgstr[1] "Descarga completada ({n} archivos)"

#: crates/core/src/app/queue.rs
msgid "Stopped as configured (the limit or the history said so)"
msgstr "Detenido según lo configurado (por el límite o el historial)"

#: crates/core/src/app/queue.rs
msgid "Download cancelled. A partial file was kept, so starting again resumes it."
msgstr "Descarga cancelada. Se conservó el archivo parcial, así que al volver a empezar continúa donde quedó."

#: crates/core/src/app/queue.rs
msgid "Recording stopped and saved"
msgstr "Grabación detenida y guardada"

#: crates/core/src/app/settings.rs
msgid "Could not find the home folder."
msgstr "No se encontró la carpeta personal."

#: crates/core/src/app/settings.rs
msgid "Osprey is now in the applications menu."
msgstr "Osprey ya está en el menú de aplicaciones."

#: crates/core/src/app/settings.rs
msgid "Osprey was removed from the applications menu."
msgstr "Osprey se quitó del menú de aplicaciones."

#: crates/core/src/app/settings.rs
#, python-brace-format
msgid "Could not change the applications menu: {e}"
msgstr "No se pudo cambiar el menú de aplicaciones: {e}"

#: crates/core/src/app/settings.rs
#, python-brace-format
msgid "Could not save the settings: {e}"
msgstr "No se pudieron guardar los ajustes: {e}"

#: crates/core/src/app/settings.rs
#, python-brace-format
msgid "History cleared ({n} entry)."
msgid_plural "History cleared ({n} entries)."
msgstr[0] "Historial borrado ({n} entrada)."
msgstr[1] "Historial borrado ({n} entradas)."

#: crates/core/src/app/settings.rs
msgid "There is no history file yet."
msgstr "Todavía no hay archivo de historial."

#: crates/core/src/app/settings.rs
#, python-brace-format
msgid "Could not clear the history: {e}"
msgstr "No se pudo borrar el historial: {e}"

#: crates/core/src/app/setup.rs
#, python-brace-format
msgid "This folder can't be written to: {folder} ({e})."
msgstr "No se puede escribir en esta carpeta: {folder} ({e})."

#: crates/core/src/app/setup.rs
msgid "Osprey keeps its tools, settings and history next to itself. Move its folder somewhere you can write to (not Program Files), such as your user folder or a USB stick."
msgstr "Osprey guarda sus herramientas, ajustes e historial junto a sí misma. Mueve su carpeta a un lugar donde puedas escribir (no Program Files), como tu carpeta de usuario o una memoria USB."

#: crates/core/src/app/setup.rs
msgid "Diagnostic information copied. Paste it into your bug report."
msgstr "Información de diagnóstico copiada. Pégala en tu reporte de error."

#: crates/core/src/app/setup.rs
msgid "Checking for updates... (requires internet)"
msgstr "Buscando actualizaciones... (requiere internet)"

#: crates/core/src/app/setup.rs
#, python-brace-format
msgid "Could not check {component} for updates: {reason}"
msgstr "No se pudo buscar actualizaciones de {component}: {reason}"

#: crates/core/src/app/setup.rs
msgid "Some components are missing or broken, installing them now"
msgstr "Faltan componentes o alguno está dañado, instalándolos ahora"

#: crates/core/src/app/setup.rs
#, python-brace-format
msgid "Could not save the choice of yt-dlp builds: {e}"
msgstr "No se pudo guardar la elección de versiones de yt-dlp: {e}"

#: crates/core/src/app/setup.rs
msgid "Some components are missing or broken"
msgstr "Algunos componentes faltan o están dañados"

#: crates/core/src/app/setup.rs
msgid "Installation completed"
msgstr "Instalación completada"

#: crates/core/src/app/setup.rs
msgid "Update completed"
msgstr "Actualización completada"

#: crates/core/src/app/setup.rs
msgid "Full reinstallation completed"
msgstr "Reinstalación completa terminada"

#: crates/core/src/app/setup.rs
msgid "yt-dlp now comes from the nightly builds"
msgstr "yt-dlp ahora viene de las versiones nightly"

#: crates/core/src/app/setup.rs
msgid "yt-dlp now comes from the stable releases"
msgstr "yt-dlp ahora viene de las versiones estables"

#: crates/core/src/app/setup.rs
#, python-brace-format
msgid "Binaries located in: {folder}"
msgstr "Programas ubicados en: {folder}"

