msgstr "Recortar del archivo"

#: crates/core/src/config.rs
msgid "Sponsors only"
msgstr "Solo patrocinios"

#: crates/core/src/config.rs
msgid "Sponsors, self-promotion, interaction"
msgstr "Patrocinios, autopromoción, interacción"

#: crates/core/src/config.rs
msgid "Everything SponsorBlock covers"
msgstr "Todo lo que cubre SponsorBlock"

#: crates/core/src/config.rs
msgid "A list of my own"
msgstr "Una lista propia"

#: crates/core/src/config.rs
msgid "Follow system"
msgstr "Según el sistema"

#: crates/core/src/config.rs ui/src/components/MainMenu.vue
msgid "Light"
msgstr "Claro"

#: crates/core/src/config.rs ui/src/components/MainMenu.vue
msgid "Dark"
msgstr "Oscuro"

#: crates/core/src/config.rs
msgid "Don't use cookies"
msgstr "No usar cookies"

#: crates/core/src/config.rs
msgid "Follow the link"
msgstr "Según el enlace"

#: crates/core/src/config.rs
msgid "Just this video"
msgstr "Solo este video"

#: crates/core/src/config.rs
msgid "The whole playlist"
msgstr "La lista completa"

#: crates/core/src/config.rs
msgid "Title [ID].ext"
msgstr "Título [ID].ext"

#: crates/core/src/config.rs
msgid "Title.ext"
msgstr "Título.ext"

#: crates/core/src/config.rs
msgid "ID.ext"
msgstr "ID.ext"

#: crates/core/src/config.rs
msgid "Title - Channel [ID].ext"
msgstr "Título - Canal [ID].ext"

#: crates/core/src/config.rs
msgid "A template of my own"
msgstr "Una plantilla propia"

#: crates/core/src/config.rs
msgid "The speed limit should look like 500K or 4.2M, or be empty."
msgstr "El límite de velocidad debe tener la forma 500K o 4.2M, o quedar vacío."

#: crates/core/src/config.rs
msgid "Concurrent fragments should be a whole number of 1 or more."
msgstr "Las partes simultáneas deben ser un número entero de 1 o más."

#: crates/core/src/config.rs
msgid "The sleep between requests should be a number such as 0, 1.5 or 2."
msgstr "La pausa entre solicitudes debe ser un número como 0, 1.5 o 2."

#: crates/core/src/config.rs
msgid "Retries should be a whole number such as 3 or 10, or empty."
msgstr "Los reintentos deben ser un número entero, como 3 o 10, o quedar vacíos."

#: crates/core/src/config.rs
msgid "The wait for a stream should be seconds or a range, such as 60 or 60-3600."
msgstr "La espera de una transmisión debe ser en segundos o un rango, como 60 o 60-3600."

#: crates/core/src/config.rs
msgid "The download limit should be a whole number, or empty."
msgstr "El límite de descargas debe ser un número entero, o quedar vacío."

#: crates/core/src/config.rs
msgid "Playlist items should look like 1-5, 8 or 2,4,6."
msgstr "Los elementos de la lista deben tener la forma 1-5, 8 o 2,4,6."

#: crates/core/src/config.rs
msgid "The container to convert to should be a name such as mp4 or mkv."
msgstr "El contenedor de destino debe ser un nombre como mp4 o mkv."

#: crates/core/src/config.rs
msgid "The custom format string can't be empty."
msgstr "La cadena de formato propia no puede quedar vacía."

#: crates/core/src/config.rs
msgid "The custom name template can't be empty."
msgstr "La plantilla de nombre propia no puede quedar vacía."

#: crates/core/src/config.rs
msgid "With auto-generated subtitles, write each language code, such as en or en,es: YouTube offers a machine translation into every language, and asking for all of them gets the download blocked."
msgstr "Con subtítulos automáticos, escribe el código de cada idioma, como en o en,es: YouTube ofrece una traducción automática a cada idioma, y pedirlas todas hace que bloquee la descarga."

#: crates/core/src/config.rs
msgid "Pick at least one SponsorBlock category."
msgstr "Elige al menos una categoría de SponsorBlock."

#: crates/core/src/config.rs
msgid "There is an empty category in the SponsorBlock list."
msgstr "Hay una categoría vacía en la lista de SponsorBlock."

#: crates/core/src/config.rs
#, python-brace-format
msgid "Unknown SponsorBlock category: {bare}"
msgstr "Categoría de SponsorBlock desconocida: {bare}"

#: crates/core/src/config.rs
#, python-brace-format
msgid "'{bare}' can only be marked, not removed."
msgstr "«{bare}» solo se puede marcar, no recortar."

#: crates/core/src/explain.rs
msgid "YouTube wants to make sure you're not a bot. Wait a while and try again."
msgstr "YouTube quiere asegurarse de que no eres un bot. Espera un rato y vuelve a intentarlo."

#: crates/core/src/explain.rs
msgid "YouTube wants to make sure you're not a bot. Use the cookies of a browser where you're signed in to YouTube: Settings, Advanced options, Signing in."
msgstr "YouTube quiere asegurarse de que no eres un bot. Usa las cookies de un navegador donde hayas iniciado sesión en YouTube: Ajustes, Opciones avanzadas, Inicio de sesión."

#: crates/core/src/explain.rs
msgid "The video password isn't right. Check it in Settings, Advanced options, Signing in, and add the link again."
msgstr "La contraseña del video no es correcta. Revísala en Ajustes, Opciones avanzadas, Inicio de sesión, y vuelve a agregar el enlace."

#: crates/core/src/explain.rs
msgid "This video is protected by a password. Type it in Settings, Advanced options, Signing in, and add the link again."
msgstr "Este video está protegido con contraseña. Escríbela en Ajustes, Opciones avanzadas, Inicio de sesión, y vuelve a agregar el enlace."

#: crates/core/src/explain.rs
msgid "Only the channel's members can watch this video. The Flatpak can't read your browser's cookies to sign in; the portable version can."
msgstr "Solo los miembros del canal pueden ver este video. El Flatpak no puede leer las cookies de tu navegador para iniciar sesión; la versión portable sí."

#: crates/core/src/explain.rs
msgid "Only the channel's members can watch this video. Use the cookies of a browser where you're signed in with a member account: Settings, Advanced options, Signing in."
msgstr "Solo los miembros del canal pueden ver este video. Usa las cookies de un navegador donde hayas iniciado sesión con una cuenta de miembro: Ajustes, Opciones avanzadas, Inicio de sesión."

#: crates/core/src/explain.rs
msgid "This video needs you signed in (it's private or age-restricted). The Flatpak can't read your browser's cookies to sign in; the portable version can."
msgstr "Este video requiere iniciar sesión (es privado o tiene restricción de edad). El Flatpak no puede leer las cookies de tu navegador para iniciar sesión; la versión portable sí."

#: crates/core/src/explain.rs
msgid "This video needs you signed in (it's private or age-restricted). Use the cookies of a browser where you're signed in: Settings, Advanced options, Signing in."
msgstr "Este video requiere iniciar sesión (es privado o tiene restricción de edad). Usa las cookies de un navegador donde hayas iniciado sesión: Ajustes, Opciones avanzadas, Inicio de sesión."

#: crates/core/src/explain.rs
msgid "This video isn't available in your country."
msgstr "Este video no está disponible en tu país."

#: crates/core/src/explain.rs
msgid "This stream or premiere hasn't started yet. Try again when it starts, or set a wait for scheduled streams in Settings, Advanced options."
msgstr "Esta transmisión o estreno todavía no empezó. Vuelve a intentarlo cuando empiece, o configura una espera para transmisiones programadas en Ajustes, Opciones avanzadas."

#: crates/core/src/explain.rs
msgid "The site got too many requests from you and is refusing more for now. Wait a while (an hour usually does it) and try again."
msgstr "El sitio recibió demasiadas solicitudes tuyas y por ahora rechaza más. Espera un rato (en general basta con una hora) y vuelve a intentarlo."

#: crates/core/src/explain.rs
msgid "The site refused the download (error 403). A newer yt-dlp usually fixes it, and it comes with the next update of the app."
msgstr "El sitio rechazó la descarga (error 403). Un yt-dlp más nuevo suele solucionarlo, y llega con la próxima actualización de la aplicación."

#: crates/core/src/explain.rs
msgid "The site refused the download (error 403). Update yt-dlp in ☰, Setup and updates, and try again."
msgstr "El sitio rechazó la descarga (error 403). Actualiza yt-dlp en ☰, Instalación y actualizaciones, y vuelve a intentarlo."

#: crates/core/src/explain.rs
msgid "Nothing was found at this link (error 404). Check that it's right and that the video still exists."
msgstr "No se encontró nada en este enlace (error 404). Comprueba que sea correcto y que el video todavía exista."

#: crates/core/src/explain.rs
msgid "The site had a problem on its side. Try again later."
msgstr "El sitio tuvo un problema de su lado. Vuelve a intentarlo más tarde."

#: crates/core/src/explain.rs
msgid "The quality or format you picked isn't available for this video. Pick another one on its card."
msgstr "La calidad o el formato que elegiste no está disponible para este video. Elige otro en su tarjeta."

#: crates/core/src/explain.rs
msgid "yt-dlp doesn't support this site or kind of link."
msgstr "yt-dlp no admite este sitio o este tipo de enlace."

#: crates/core/src/explain.rs
msgid "The disk is full. Free some space and try again."
msgstr "El disco está lleno. Libera espacio y vuelve a intentarlo."

#: crates/core/src/explain.rs
msgid "This video is unavailable: it was removed or made private, or the link is wrong."
msgstr "Este video no está disponible: se eliminó o se hizo privado, o el enlace es incorrecto."

#: crates/core/src/explain.rs
msgid "Couldn't reach the site. Check your internet connection and try again."
msgstr "No se pudo conectar con el sitio. Comprueba tu conexión a internet y vuelve a intentarlo."

#: crates/core/src/live.rs
msgid "Nothing was recorded yet."
msgstr "Todavía no se grabó nada."

#: crates/core/src/live.rs
msgid "The recording has no file name."
msgstr "La grabación no tiene nombre de archivo."

#: crates/core/src/live.rs
#, python-brace-format
msgid "Could not start FFmpeg: {e}"
msgstr "No se pudo iniciar FFmpeg: {e}"

#: crates/core/src/live.rs
msgid "FFmpeg took too long to save the recording."
msgstr "FFmpeg tardó demasiado en guardar la grabación."

#: crates/core/src/live.rs
#, python-brace-format
msgid "FFmpeg could not save the recording: {error}"
msgstr "FFmpeg no pudo guardar la grabación: {error}"

#: crates/core/src/live.rs
#, python-brace-format
msgid "Could not move the recording into place: {e}"
msgstr "No se pudo mover la grabación a su lugar: {e}"

#: crates/core/src/metadata.rs
msgid "Timed out looking up this link."
msgstr "Se agotó el tiempo al consultar este enlace."

#: crates/core/src/metadata.rs crates/core/src/runner.rs
#, python-brace-format
msgid "Could not start {tool}: {e}"
msgstr "No se pudo iniciar {tool}: {e}"

#: crates/core/src/metadata.rs
msgid "yt-dlp could not look up this link."
msgstr "yt-dlp no pudo consultar este enlace."

#: crates/core/src/metadata.rs
msgid "yt-dlp returned no information for this link."
msgstr "yt-dlp no devolvió información sobre este enlace."

#: crates/core/src/metadata.rs
#, python-brace-format
msgid "Could not read yt-dlp's output: {e}"
msgstr "No se pudo leer la respuesta de yt-dlp: {e}"

#: crates/core/src/provision/archive.rs
#, python-brace-format
msgid "The archive didn't contain {files} (unexpected layout)."
msgstr "El archivo comprimido no contenía {files} (estructura inesperada)."

#: crates/core/src/provision/archive.rs
#, python-brace-format
msgid "Could not install {name}: {e}"
msgstr "No se pudo instalar {name}: {e}"

#: crates/core/src/provision/archive.rs
#, python-brace-format
msgid "Could not read the archive: {e}"
msgstr "No se pudo leer el archivo comprimido: {e}"

#: crates/core/src/provision/download.rs
#, python-brace-format
msgid "Download failed ({e}), retrying... (attempt {n}/{attempts})"
msgstr "La descarga falló ({e}), reintentando... (intento {n}/{attempts})"

#: crates/core/src/provision/download.rs
#, python-brace-format
msgid "Failed to download {name} after {attempts} attempts ({e})"
msgstr "No se pudo descargar {name} tras {attempts} intentos ({e})"

#: crates/core/src/provision/download.rs
msgid "Please check your internet connection and try again."
msgstr "Revisa tu conexión a internet y vuelve a intentarlo."

#: crates/core/src/provision/download.rs
#, python-brace-format
msgid "no data received for {seconds} seconds"
msgstr "no se recibieron datos durante {seconds} segundos"

#: crates/core/src/provision/download.rs
msgid "the download stopped unexpectedly"
msgstr "la descarga se detuvo inesperadamente"

#: crates/core/src/provision/download.rs
msgid "the file is unexpectedly large"
msgstr "el archivo es inesperadamente grande"

#: crates/core/src/provision/mod.rs
msgid "Nightly (recommended)"
msgstr "Nightly (recomendada)"

#: crates/core/src/provision/mod.rs
msgid "Stable"
msgstr "Estable"

#: crates/core/src/provision/mod.rs
